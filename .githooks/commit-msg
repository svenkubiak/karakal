#!/bin/bash
# Rejects commit messages that do not follow Conventional Commits (https://www.conventionalcommits.org).
# Enable once per clone with: git config core.hooksPath .githooks
#
# Keep CONVENTIONAL_COMMIT_REGEX in sync with release.sh

CONVENTIONAL_COMMIT_REGEX='^(feat|fix|perf|refactor|docs|test|build|ci|chore|style|revert)(\([a-z0-9._/-]+\))?!?: .+'

SUBJECT=$(head -n 1 "$1")

# Messages generated by git itself (merge, fixup, squash) are allowed as is
if [[ "$SUBJECT" =~ ^(Merge|fixup!|squash!|amend!) ]]; then
  exit 0
fi

if [[ ! "$SUBJECT" =~ $CONVENTIONAL_COMMIT_REGEX ]]; then
  echo "✖  Commit message does not follow Conventional Commits:" >&2
  echo >&2
  echo "     $SUBJECT" >&2
  echo >&2
  echo "   Expected: <type>(<optional scope>): <description>" >&2
  echo "   Types:    feat, fix, perf, refactor, docs, test, build, ci, chore, style, revert" >&2
  echo "   Example:  fix(webauthn): enforce user verification on registration" >&2
  echo >&2
  echo "   See the Contributing section in README.md" >&2
  exit 1
fi
